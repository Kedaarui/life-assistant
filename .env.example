# 复制为 .env.local 后填写，修改后需要重启 npm run dev
# 可选值：deepseek | glm | qwen | custom
LLM_PROVIDER=deepseek

# 必填：对应平台的 API Key
LLM_API_KEY=

# 可选：覆盖平台默认值（custom 时必填）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_CHAT_MODEL=deepseek-chat

# ===== 语义检索（P2）=====
# 默认使用通义 text-embedding-v3（1024 维）
# DeepSeek 没有 embedding 接口；也可以配置任意 OpenAI 兼容 embedding 服务
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024

# 可选：自定义数据目录（默认 ./data）
# LIFE_DATA_DIR=./data
